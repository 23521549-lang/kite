# OpenCode release used by Kite's images (the chat's server and the per-task sandbox): the linux-x64 build
# from npm (@opencode/cli-linux-x64), checked against this SHA-512 of the package. Kite's chat was tested
# against this version (OPENCODE_TESTED in poc/kaggle_worker/web/app.py).
OPENCODE_VERSION=2.4.0
OPENCODE_SHA512=987ee1f0702e48c1fe820158d6882285b432d712cc5f52fb7c4f7a8aa45357d7341fa6a93e84db3e0109295d2a6c91b2eb4a778c1b0cbe678c570ebb4a8642af
# SHA-512 of the binary inside that package (package/bin/opencode): `kite sandbox build` checks the
# host's binary against it before baking the binary into the local sandbox image.
OPENCODE_BIN_SHA512=a4d8b2d0338a5e742f70dab50082a8f655025e1b2211d2f81a038400382ec8f72506ee99f1939eb2852770da8d4fe0c358c4cfa2c38748001db12339710c2855
